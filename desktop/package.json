{
  "name": "metachlorian-desktop",
  "version": "0.1.0",
  "description": "Metachlorian desktop app: the web UI in a native shell that runs or connects to a Metachlorian core.",
  "main": "src/main.js",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test src/*.test.js",
    "package": "electron-builder",
    "package:dir": "electron-builder --dir",
    "bundle": "node scripts/bundle.mjs",
    "check-package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "org.metachlorian.app",
    "productName": "Metachlorian",
    "afterPack": "./scripts/adhoc-sign-mac.mjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "bundle/python",
        "to": "python"
      },
      {
        "from": "bundle/app",
        "to": "app"
      },
      {
        "from": "bundle/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo",
      "desktop": {
        "entry": {
          "StartupWMClass": "Metachlorian"
        }
      },
      "executableName": "metachlorian-desktop"
    },
    "publish": {
      "provider": "github",
      "owner": "JeremySNR",
      "repo": "Metachlorian",
      "releaseType": "draft"
    },
    "icon": "assets/icon.png"
  },
  "desktopName": "metachlorian.desktop"
}
